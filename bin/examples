#!/usr/bin/env ruby
# frozen_string_literal: true

# Runs every Ruby file under examples/, each in its own Ruby process, and
# fails if one exits with an error. A line ending with "# => VALUE" must
# evaluate to an object whose inspect is VALUE. A manifest of brutal,
# NAME_brutal.yaml, is checked with brutal: the test file next to it must be
# the one brutal writes from it.
#
# The gems come from the environment, for instance:
#   RUBYLIB=../matchi/lib bin/examples examples/matchi
#   RUBYLIB=../brutal/lib:../aw/lib bin/examples examples/brutal
# For each example, the file loaded by each of its top-level requires is
# printed, so that the version under test is visible.
#
# A terminal session of a page, <pre data-directory="DIRECTORY"><kbd>COMMAND
# </kbd><samp>OUTPUT</samp></pre>, that runs an example under the roots is run
# too: COMMAND, `ruby FILE` or `fix` with its paths, runs in DIRECTORY, and what
# it writes, on its standard output and error together, must be OUTPUT. A
# session of `fix --random` runs the command its output writes first. An
# example a session runs is checked by the session, whatever its status, and is
# run on its own only for its `# =>` lines, if it has any.
#
# A few examples are files of another repository, shown as they are there, where
# they run inside an application the site does not have: ELSEWHERE lists them,
# and they are skipped, with a line saying so.

require "cgi/escape"
require "open3"
require "rbconfig"

if ENV["RUBYLIB"]
  ENV["RUBYLIB"] = ENV["RUBYLIB"].split(File::PATH_SEPARATOR).map { |dir| File.expand_path(dir) }
                                 .join(File::PATH_SEPARATOR)
end
site = File.expand_path("..", __dir__)
roots = ARGV.empty? ? [File.join(site, "examples")] : ARGV.map { |root| File.expand_path(root) }
Dir.chdir(site)

EXPECTATION = /\A(?<code>.*\S)\s+#\s*=>\s*(?<value>.+)\z/
REQUIRE = /^require "([^"]+)"$/

# Defines the check, then evaluates the example read from standard input under
# its own file name, so that backtraces point at the example's lines. At exit,
# after any test framework has run, prints where each required file came from.
RUNNER = <<~'RUBY'
  def __example__(value, expected, line)
    actual = value.inspect
    abort "line #{line}: expected #{expected}, got #{actual}" unless actual == expected
  end

  at_exit do
    ARGV.drop(1).each do |name|
      loaded = $LOADED_FEATURES.find { |feature| feature.end_with?("/#{name}.rb") }
      puts "required #{name} from #{loaded || "nowhere: install the gem for this Ruby, or put its lib on RUBYLIB"}"
    end
  end

  # The example is UTF-8, as a Ruby file is, whatever the locale.
  eval($stdin.read.force_encoding(Encoding::UTF_8), TOPLEVEL_BINDING, ARGV.fetch(0), 1)
RUBY

def instrument(source)
  source.each_line(chomp: true).with_index(1).map do |line, number|
    match = EXPECTATION.match(line)
    match ? "__example__((#{match[:code]}), #{match[:value].dump}, #{number})" : line
  end.join("\n")
end

# Checks a manifest of brutal: brutal --check runs its code and compares the
# test file in place with the one it would write. Prints where brutal came from.
BRUTAL = <<~'RUBY'
  require "brutal"
  puts "required brutal from #{$LOADED_FEATURES.find { |feature| feature.end_with?("/brutal.rb") }}"
  exit Brutal::CLI.run(["--check", ARGV.fetch(0)])
RUBY

paths = roots.flat_map { |root| File.file?(root) ? [root] : Dir.glob("#{root}/**/*.{rb,yaml}") }
             .map { |path| path.delete_prefix("#{Dir.pwd}/") }.sort
abort "No example found in #{roots.join(', ')}" if paths.empty?

# The files of fixrb/microblog that the guide of Fix shows: they run in that
# Rails application, not here.
ELSEWHERE = %w[
  examples/fix/v1/in-a-rails-application/fix/controllers/posts_fix.rb
  examples/fix/v1/in-a-rails-application/fix/models/post_fix.rb
  examples/fix/v1/in-a-rails-application/fix/support/rails.rb
].freeze

SESSION = %r{<pre data-directory="([^"]+)"><kbd>([^<]*)</kbd>\n<samp>(.*?)</samp></pre>}m
FIX = 'require "fix/command"; exit(Fix::Command.run(ARGV))'

# The examples a session runs, as bin/check finds them: the file of `ruby
# FILE`; for `fix`, the files given and the *_fix.rb files of the directories
# given, the fix directory when none is.
def session_files(directory, words)
  return [File.join(directory, words.fetch(1))] if words.first == "ruby"

  paths = words.drop(1).reject { |word| word.start_with?("-") }
  (paths.empty? ? ["fix"] : paths).flat_map do |name|
    path = File.join(directory, name)
    File.directory?(path) ? Dir.glob("**/*_fix.rb", base: path).sort.map { |file| File.join(path, file) } : [path]
  end
end

# The sessions of the pages that run an example under the roots. bin/check has
# checked their form.
sessions = Dir.glob("**/*.html").sort.flat_map do |page|
  File.read(page, encoding: "UTF-8").scan(SESSION).map do |directory, command, output|
    output = CGI.unescapeHTML(output)
    words = CGI.unescapeHTML(command).split
    words = output.lines.first.split if words.include?("--random")
    { page:, directory:, words:, output:, files: session_files(directory, words) }
  end
end.reject { |session| (session[:files] & paths).empty? }

covered = sessions.flat_map { |session| session[:files] }.reject do |path|
  File.read(path, encoding: "UTF-8").each_line.any? { |line| EXPECTATION.match?(line.chomp) }
end

(paths & ELSEWHERE).each { |path| puts "skip #{path}: runs in fixrb/microblog" }

failures = (paths - covered - ELSEWHERE).reject do |path|
  if path.end_with?(".yaml")
    output, status = Open3.capture2e(RbConfig.ruby, "-e", BRUTAL, path, binmode: true)
  else
    source = File.read(path, encoding: "UTF-8")
    output, status = Open3.capture2e(RbConfig.ruby, "-e", RUNNER, path, *source.scan(REQUIRE).flatten,
                                     stdin_data: instrument(source), binmode: true)
  end
  puts "#{status.success? ? 'ok  ' : 'FAIL'} #{path}"
  # A forked child runs the at_exit hook too: show each line once.
  shown = status.success? ? output.lines.grep(/\Arequired /).uniq : output.lines
  print shown.join.gsub(/^/, "     ") unless shown.empty?
  status.success?
end

failures += sessions.reject do |session|
  words = session[:words]
  command = words.first == "ruby" ? [RbConfig.ruby, *words.drop(1)] : [RbConfig.ruby, "-e", FIX, "--", *words.drop(1)]
  output, = Open3.capture2e(*command, chdir: session[:directory], binmode: true)
  met = output.force_encoding(Encoding::UTF_8) == "#{session[:output]}\n"
  puts "#{met ? 'ok  ' : 'FAIL'} #{session[:page]}: #{words.join(' ')}, in #{session[:directory]}"
  print output.gsub(/^/, "     ") unless met
  met
end

exit(failures.empty? ? 0 : 1)
